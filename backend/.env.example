# Configuration MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=database
MONGO_DB=lumieres

# Optionnel
PORT=8080
DATA_DIR=data
# Clé UPCitemdb payante. Sans clé : offre d'essai, limitée à 100 scans par jour.
UPCITEMDB_KEY=
# Force l'adresse de la carte pour la détection. Sans cette ligne, elle est trouvée sur le réseau.
DMX_GATEWAY_URL=
